UNWIND [{name:"Điều 14", content:"Thẩm quyền bổ nhiệm, miễn nhiệm, bãi nhiệm các chức danh giảng dạy", properties:{}}, {name:"Điều 15", content:"Các trường hợp bổ nhiệm, miễn nhiệm, bãi nhiệm chức danh giảng dạy ", properties:{}}, {name:"Điều 16", content:"Thời điểm xét bổ nhiệm, miễn nhiệm, bãi nhiệm các chức danh giảng dạy", properties:{}}, {name:"Điều 22", content:"Hồ sơ, thủ tục miễn nhiệm, bãi nhiệm chức danh giảng dạy", properties:{}}, {name:"Điều 5", content:"Trợ giảng", properties:{}}, {name:"Điều 6", content:"Giảng viên", properties:{}}, {name:"Điều 7", content:"Giảng viên chính", properties:{}}, {name:"Điều 9", content:"Giáo viên", properties:{}}, {name:"Điều 10", content:"Giáo viên chính", properties:{}}, {name:"Điều 11", content:"Giáo viên cao cấp", properties:{}}, {name:"Điều 17", content:"Hội đồng cấp trường ", properties:{}}, {name:"Điều 18", content:"Hội đồng cấp bộ ", properties:{}}, {name:"Điều 19", content:"Quy trình bổ nhiệm chức danh Trợ giảng, Giảng viên, Giáo viên và Giáo viên chính ", properties:{}}, {name:"Điều 20", content:"Quy trình bổ nhiệm chức danh Giảng viên chính, Giáo viên cao cấp ", properties:{}}] AS row
