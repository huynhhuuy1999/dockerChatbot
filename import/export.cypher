UNWIND [{name:"Điều 11", content:"Trách nhiệm và quyền hạn của giảng viên", properties:{}}, {name:"Điều 10", content:"Trách nhiệm và quyền hạn của cán bộ, chiến sĩ", properties:{}}, {name:"Điều 12", content:"Trách nhiệm và quyền hạn của giảng vién thỉnh giảng", properties:{}}, {name:"Điều 6", content:"Trách nhiệm, phạm vi giải quyết công việc của Thủ trưởng\nđơn vị trực thuộc Trường", properties:{}}, {name:"Điều 7", content:"Trách nhiệm, pham vi giải quyết công việc của Phó Thủ\ntrưởng đơn vị", properties:{}}, {name:"Điều 50", content:"Trách nhiệm của Thủ trưởng các đơn vị trong tiếp cán bộ,\nchiến sĩ", properties:{}}, {name:"Điều 22", content:"Căn cứ xây dựng chương trình công tác", properties:{}}, {name:"Điều 29", content:"Trình duyệt, ký văn bản", properties:{}}, {name:"Điều 30", content:"Thẩm quyền duyệt, ký văn bản", properties:{}}, {name:"Điều 38", content:"Trình tự tỗ chức hội nghị, cuộc hop", properties:{}}, {name:"Điều 49", content:"Trách nhiệm của Hiệu trưởng trong tiếp cán bộ, chiến sĩ", properties:{}}, {name:"Điều 23", content:"Trình tự xây dựng chương trình công tác", properties:{}}, {name:"Điều 2", content:"Nguyên tắc làm việc", properties:{}}, {name:"Điều 20", content:"Các loại chương trình công tác", properties:{}}, {name:"Điều 34", content:"Nguyên tắc tổ chức các hội nghị, cuộc họp", properties:{}}, {name:"Điều 35", content:"Các loại hội nghị, cuộc hop ", properties:{}}, {name:"Điều 37", content:"Thẩm quyền phê duyệt tổ chức hội nghị, cuộc họp", properties:{}}, {name:"Điều 41", content:"Tổ chức nghi lễ", properties:{}}, {name:"Điều 2", content:"Nguyên tắc bổ nhiệm, bãi nhiệm, miễn nhiệm các chức danh giảng dạy", properties:{}}, {name:"Điều 3", content:"Tiêu chuẩn chung của các chức danh giảng dạy", properties:{}}] AS row
