CREATE CONSTRAINT dieu_name_content_unique FOR (node:DIEU) REQUIRE (node.name, node.content) IS UNIQUE;
CREATE CONSTRAINT user_username_unique FOR (node:ADMIN) REQUIRE (node.username) IS UNIQUE;
CREATE CONSTRAINT UNIQUE_IMPORT_NAME FOR (node:`UNIQUE IMPORT LABEL`) REQUIRE (node.`UNIQUE IMPORT ID`) IS UNIQUE;
UNWIND [{_id:1, properties:{answer:"1. Tuân thủ quy định của Đảng, pháp luật của Nhà nước. Mọi hoạt động của Trường phải đặt dưới sự lãnh đạo tuyét đối, trực tiếp về mọi mặt của Đảng ủy Công an Trung ương, thường xuyên, trực tiếp là Đảng ủy Trường Đại học An ninh nhân dân; sự chỉ đạo, điều hành của lãnh đạo Bộ Công an và sự chỉ huy, quản lý trực tiếp của Hiệu trưởng Trường Đại học An ninh nhân dân.\n2. Trường Đại học An ninh nhân dân làm việc theo chế độ thủ trưởng; nguyên tắc tập trung dân chủ, tập thể lãnh đạo, cá nhân phụ trách; cấp dưới phục tùng, cấp trên; phân công, phân cấp rõ ràng, cụ thể.\n3. Giải quyết công việc đúng phạm vi thẩm quyền và trách nhiệm phân công; đúng trình tự, thủ tục theo quy định của pháp luật và của Bộ Công an; chương trình, kế hoạch công tác đã được phê duyệt và quy định tại Quy chế này, trừ trường hợp có yêu cầu đột xuất.\n4. Đề cao trách nhiệm cá nhân của người đứng đầu; một đơn vị có thể làm nhiều việc và một việc chỉ giao cho một đơn vị chủ trì và chịu trách nhiệm chính; mỗi nhiệm vụ chỉ giao cho một người chủ trì và chịu trách nhiệm. Nếu nhiệm vụ giao cho đơn vi nào thì Thủ trưởng đơn vị đó phải chịu trách nhiệm chính và chủ động phối hợp công tác, trao đổi thông tin, hiệp đồng chặt chẽ với các đơn vị khác theo chức năng, nhiệm vụ, quyền hạn của từng đơn vị và theo quy định tại Quy chế này.\n5. Bảo đảm bí mật công tác và bí mật nghiệp vụ, thông tin chính xác, thông suốt, kịp thời trong mọi hoạt động của từng đơn vị, Trường và Ngành.\n6. Bảo đảm sự lãnh đạo, chỉ đạo, chỉ huy tập trung, thống nhất, xuyên suốt từ Ban Giám hiệu đến các đơn vị; giữ nghiêm kỷ cương, kỷ luật; nâng cao hiệu lực, hiệu quả các mặt công tác chuyên môn. \ntest", dieu:"Điều 2"}}, {_id:7, properties:{answer:"Phạm vi giải quyết công việc \na) Chủ động chi đạo triển khai thực hiện công việc thuộc chức nang, nhiệm vụ và quyền hạn của đơn vị\nb) Chủ động phối hợp với Thủ trưởng các đơn vi khác để xử lý các vấn đề liên quan đến công việc thuộc chức năng, nhiệm vụ của đơn vị và thực hiện nhiệm vụ chung của Trường; \nc) Duyệt, ký thừa, ký thừa ủy quyền của Hiệu trưởng một số văn bản được Hiệu trưởng ủy quyền giải quyết theo quy định và phải chịu trách nhiệm cá nhân trước pháp luật và trước Hiệu trưởng về nội dung được ủy quyền. Thủ trưởng các đơn vị: Phòng Hành chính tổng hợp, Phòng Chính trị, Phòng Quản lý đào tạo và bồi dưỡng nâng cao, Phòng Bảo đảm chất lượng đào tạo, Phòng Quản lý nghiên cứu khoa học, Phòng Quản lý học viên, Phòng Hậu cần được sử dụng con dấu của Trường khi thừa lệnh, thừa ủy quyền Hiệu trưởng để giải quyết công việc theo chức năng, nhiệm vụ được giao; \nd) Xây dựng và kiểm tra việc thực hiện quy chế làm việc của đơn vị theo Quy chế làm việc của Trường. Thực hiện công tác quản lý cán bộ, chiến sĩ, nhân viên trong đơn vị. Phân công công tác cho cấp phó và cán bộ, chiến sĩ, nhân viên thuộc quyền quản lý. Đề nghị bổ nhiệm, miễn nhiệm cấp trưởng, phó các đội; điều chuyển cán bộ; ký kết, chấm dứt hợp đồng của nhân viên lao động hợp đồng của đơn vị theo quy định; \ne) Điều hành đơn vị chấp hành chính sách của Đảng, pháp luật của Nhà nước, nghị quyết, chỉ thị, quy chế, quy định của Bộ Công an, Điều lệnh Công an nhân dân và các quy chế, nội quy, quy định của Trường:;\ng) Thực hiện những nhiệm vụ khác do Hiệu trưởng hoặc Phó Hiệu trưởng giao.\n", dieu:"Điều 6", entity:"ThuTruong"}}, {_id:9, properties:{answer:"1. Phó Thủ trưởng đơn vị là người giúp việc cho Thủ trưởng đơn vị, thay mặt Thủ trưởng đơn vị trực tiếp điều hành các công việc được Thủ trưởng đơn vị phân công. \n2. Chịu trách nhiệm trước Thủ trưởng đơn vị về kết quả thực hiện nhiệm vụ được giao. \n3. Báo cáo Thủ trưởng đơn vị tình hình, kết quả công việc theo quy định. \n4. Trực tiếp phụ trách một số đội, bộ phận công tác theo sự phân công của Thủ trưởng đơn vị. \n5. Ký thay Thủ trưởng đơn vị các văn bản theo ủy quyền của Thủ trưởng, đơn vị về các nội dung thuộc chức năng, nhiệm vụ của đơn vị. \n6. Thực hiện các công việc khác do Thủ trưởng đơn vị phân công. \n7. Khi vắng mặt cơ quan phải báo cáo Thủ trưởng đơn vị theo quy định; vắng từ 02 ngày trở lên phải báo cáo xin phép Hiệu trưởn ặ ó Hiệu trưởng phụ trách\n", dieu:"Điều 7", entity:"PhoThuTruong"}}, {_id:14, properties:{answer:"Cán bộ, chiến sĩ là người trực tiếp thực hiện các chủ trương, mệnh lệnh, chương trình, kế hoạch công tác của lãnh đạo cấp trên khi được phân công và phải có trách nhiệm với công việc được giao, thường xuyên báo cáo cho lãnh đạo cấp trên biết kết quả thực hiện công việc. Cán bộ, chiến sĩ của Trường ngoài những quyền lợi và nghĩa vụ theo quy định của pháp luật, của Bộ Công an còn có những trách nhiệm và quyền hạn sau: \n1. Chấp hành nghiêm chỉnh đường lối, chủ trương, chính sách của Đảng, pháp luật của Nhà nước, nghị quyết, chỉ thị, quy chế, quy định của Bộ Công an, Điều lệnh Công an nhân dân và các quy chế, nội quy, quy định của Trường. \n2. Hoàn thành nhiệm vụ chuyên môn và các công tác khác do Ban Giám hiệu và đơn vị quản lý trực tiếp giao cho. Trong công tác phải chủ động và có trách nhiệm phối hợp với cán bộ trong đơn vị hoặc các đơn vị khác trong Trường khi được giao cùng thực hiện chung một nhiệm vụ. \n3. Tham gia xây dụng đơn vị trong sạch, vững mạnh. Tham gia tích cực các hoạt động chính trị, văn hóa, xã hội, thể dục, thể thao và không ngừng học tập nâng cao trình độ chuyên môn nghiệp vụ. \n4. Thường xuyên rèn luyện ý thức tổ chức kỷ luật, nếp sống lành mạnh và trách nhiệm trong công tác. Không quan liêu, cửa quyền, hách dịch; chấp hành sự điều động, phân công công tác của cấp trên. Có ý thức tiết kiệm, bảo vệ của công, bảo vệ môi trường và phòng, chống cháy nổ.\n 5. Cán bộ được giao quản lý trực tiếp các thiết bị, tài sản của Trường phải bồi thường một phần hay toàn bộ theo thời giá thị trường nếu làm hư hỏng hay làm mất các thiết bị, tài sản đó. \n6. Nghiêm chỉnh chấp hành chế độ thông tin, báo cáo theo Điều lệnh Công an nhân dân và Quy chế làm việc của Trường. Có ý thức bảo vệ bí mật nhà nước, bí mật nội bộ. \n7. Được đào tạo, bồi dưỡng chuyên môn, nghiệp vụ theo quy định của Bộ Công an. \n8. Được tham dự các hội nghị, hội thảo khoa học trong va ngoài nước theo quy định. \n9. Thực hiện các nhiệm vụ trực ban, trực chiến và công việc đột xuất khác theo sự phân công của đơn vi. \n10. Khi vắng mặt cơ quan phải báo cáo Đội trưởng, lãnh đạo đơn vị theo quy định; vắng từ 02 ngày trở lên phải báo cáo xin phép Ban Giám hiệu.", dieu:"Điều 10", entity:"CBCS"}}, {_id:15, properties:{answer:"Giảng viên của Trường ngoài những trách nhiệm và quyền hạn chung đối với cán bộ, chiến sĩ quy định tại Điều 10 Quy chế này, Luật Giáo dục, Luật Giáo dục đại học, quy định chung về nhà giáo của Nhà nước và ngành Công an, còn có trách nhiệm và quyền hạn sau: \n1. Thực hiện giảng dạy và nghiên cứu khoa học theo quy định của Bộ Công an, Bộ Giáo dục và Đào tạo và các quy định của Trường. \n2. Không ngừng học tập để nâng cao trình độ chính trị, chuyên môn nghiệp vụ, phẩm chất đạo đức, thường xuyên cải tiến phương pháp giảng dạy đề nâng cao chất lượng đào tạo. \n3. Chủ trì hoặc tham gia đề tài nghiên cứu khoa học các cấp. \n4. Tích cực tham gia công tác quản lý giáo dục học viên; hướng dẫn, giúp đỡ học viên trong học tập, nghiên cứu khoa học, rèn luyện tư tưởng, đạo đức, tác phong, 1ối sống. \n5. Được đảm bảo về mặt tổ chức và vật chất kỹ thuật cho các hoạt động nghề nghiệp; được sử dụng các dịch vụ đào tạo, nghiên cứu khoa học và dịch vụ công của Trường. \n6. Được đăng ký xét công nhận, được bổ nhiệm các chức danh giảng dạy; xét tặng các danh hiệu theo quy định của Nhà nước, Bộ Công an. \n7. Được ký hợp đồng giảng dạy, nghiên cứu khoa học với các cơ sở đào tạo, cơ sở nghiên cứu, cơ quan quản lý nhà nước của các đơn vị, địa phương khi được Hiệu trưởng phê duyệt và phải thực hiện đầy đủ chế độ thông tin, báo cáo theo quy định.", dieu:"Điều 11", entity:"GiangVien"}}, {_id:16, properties:{answer:"Giảng viên thinh giảng tai Trường là người trong biên chế Công an nhân dân hoặc đã nghỉ hưu không thuộc biên chế cơ hữu tại các đơn vị giảng dạy; là người ngoài ngành Công an đảm bảo tiêu chuẩn theo quy định của Bộ Giáo dục và Đào tạo, Bộ Công an và Trudng Đại học An ninh nhân dân đã được các cấp bổ nhiệm theo quy định.\nTrách nhiệm và quyền hạn của giảng viên thỉnh giảng được quy định tại Luật Giáo dục; Thông tư quy định về chế độ thỉnh giảng của Bộ Giáo dục và Đào tao, Bộ Công an và Quy định về chế độ thỉnh giảng tại Trường.\n", dieu:"Điều 12", entity:"GiangVienThinhGiang"}}, {_id:20, properties:{answer:"Chương trình công tác của Trường là các nhiệm vụ, giải pháp trên các lĩnh vực công tác thuộc chức năng, nhiệm vụ của Trường; các hoạt động, công việc dự kiến hoặc cần triển khai thực hiện trong năm học, học kỳ, tháng, tuần của Trường, Ban Giám hiệu và các đơn vị. Chương trình công tác của Trường gồm: \n1. Chương trình công tác năm học là những nhiệm vụ, giải pháp; các hoạt động, công việc dự kiến hoặc cần triển khai thực hiện trong năm học của Trường. \n2. Chương trình công tác học kỳ là cụ thể hóa chương trình công tác năm học, được quy định thực hiện trong từng học kỳ và những công việc bổ sung, điều chỉnh cần giải quyết trong học kỳ. \n3. Chương trình công tác quý là cụ thể hóa chương trình công tác năm học, học kỳ được quy định thực hiện trong từng quý và những công việc bổ sung, điều chinh cần giải quyết trong quý. \n4. Chương trình công tác tháng là cụ thể hóa chương trình công tác học kỳ, được quy định thực hiện trong từng tháng của học kỳ và những công việc cần bd sung, điều chỉnh trong tháng.\n5. Chương trinh công tác tuần của Ban Giám hiệu, gồm các công việc mà Hiệu trưởng, các Phó Hiệu trưởng giải quyết hằng ngày trong tuần\n", dieu:"Điều 20"}}, {_id:27, properties:{answer:"Chương trình công tác năm học \na) Chậm nhất vào ngày 01 tháng 7 hàng năm, các đơn vị gửi đăng ký nội dung chương trình công tác năm học của Trường do đơn vị tham mưu thực hiện theo chức năng, nhiệm vụ được giao về Ban Giám hiệu (qua Phòng Hành chính tổng hợp); \nb) Phòng Hành chính tổng hợp tham mưu xây dựng dự thảo chương trình công tác năm học của Trường, gửi các đơn vị, tổ chức quần chúng tham gia ý kiến; \nc) Trên cơ sở ý kiến của đơn vị, tổ chức quần chúng, Phòng Hành chính tổng hợp tiếp thu hoàn chinh chương trình công tác và xin ý kiến Ban Giám hiệu thống nhất trước khi trình Hiệu trưởng ký ban hành; \nd) Sau khi chương trình công tác năm học được Hiệu trưởng ký ban hành, Phòng Hành chính tổng hợp gửi đến tất cả các đơn vị, tổ chúc quần chúng trong Trường tổ chức thực hiện.\n", dieu:"Điều 23", khoan:1, entity:"Nam"}}, {_id:28, properties:{answer:"Chương trình công tác học kỳ\na) Chậm nhất vào ngày 31/12 hằng năm, các đơn vị gửi báo cáo đánh giá kết quả thực hiện chương trình công tác trong học kỳ I rà soát các vấn đề cần điều chỉnh, bổ sung vào chương trình công tác học kỳ II trình Ban Giám hiệu (qua Phòng Hành chính tổng hợp);\nb) Phòng Hành chính tổng hợp tổng hợp, xây dựng dự thảo chương trinh công tác học kỳ II của Trường, gửi các đơn vị, tổ chức quần chúng tham gia ý kiến; \nc) Trên cơ sở ý kiến của các đơn vị, tổ chức quần chúng, Phòng Hành chính tổng hợp tiếp thu hoàn chỉnh chương trình công tác và xin ý kiến Ban Giám hiệu thống nhất trước khi trình Hiệu trưởng ký ban hành; \nd) Sau khi chương trình công tác học kỳ II được Hiệu trưởng ký ban hành, Phòng Hành chính tổng hợp gửi đến tất cả các đơn vị trong Trường biết và tổ chức thực hiện.\n", dieu:"Điều 23", khoan:2, entity:"HocKy"}}, {_id:29, properties:{answer:"Chương trình công tác quý \na) Chậm nhất vào ngày 10 của tháng cuối quý, các đơn vị gửi báo cáo đánh giá kết quả thực điều chỉnh, bổ sung vào chương trình công tác quý tiếp theo trình Ban Giám hiệu (qua Phòng Hành chính tổng hợp);\nb) Phòng Hành chính tổng hợp tổng hợp, xây dựng dự thảo chương trình công tác quý tiếp theo của Trường, gửi các đơn vị, tổ chức quần chúng tham gia ý kiến; \nc) Trên cơ sở ý kiến của các đơn vị, tổ chức quần chúng, Phòng Hành chính tổng hợp tiếp thu hoàn chỉnh chương trình công tác và xin ý kiến Ban Giám hiệu thống nhất trước khi trình Hiệu trưởng ký ban hành; \nd) Sau khi chương trình công tác quý tiếp theo được Hiệu trưởng ký ban hành, Phòng Hành chính tổng hợp gửi đến tất cả các đơn vị trong Trường biết và tổ chức thực hiện.", dieu:"Điều 23", khoan:3, entity:"Quy"}}, {_id:30, properties:{answer:"Chương trình công tác tháng\na) Chậm nhất vào ngày 10 hàng tháng, Thủ trưởng các đơn vị căn cứ vào tiến độ thực hiện các nội dung công việc theo chương trình công tác học kỳ, quý, những vấn đề còn tồn động hoặc mới phát sinh, đề xuất nội dung xây dựng chương trình công tác tháng tiếp theo của Trường, trình Ban Giám hiệu (qua Phòng Hành chính tổng hop); \nb) Phòng Hành chính tổng hợp tổng hợp, xây dưng dự thảo chương trình công tác tháng tiếp theo của Trường, gửi các đơn vị, tổ chức quần chúng tham gia ý kiến; \nc) Trên cơ sở ý kiến của các đơn vị, tổ chức quần chúng, Phòng Hành chính tổng hợp tiếp thu hoàn chỉnh chương trình công tác và xin ý kiến Ban Giám hiệu thống nhất trước khi trình Hiệu trưởng ký ban hành; \nd) Sau khi chương trình công tác thang tiếp theo được Hiệu trưởng ký ban hành, Phòng Hành chính tổng hợp gửi đến tất cả các đơn vị trong Trường biết và tổ chức thực hiện.\n", dieu:"Điều 23", khoan:4, entity:"Thang"}}, {_id:31, properties:{answer:"Chương trình công tác tuần của Ban Giám hiệu\na) Căn cứ vào chương trình công tác, chỉ đạo của Ban Giám hiệu,thủ trưởng các đơn vị đăng ký nội dung công việc của Ban Giám hiệu chỉ đạo/tham gia tuần sau do đơn vị tham mưu và gửi về Phòng Hành chính tổng hợp (trước 11h00’) để tập hợp, tham mưu xây dựng lịch công tác tuần của Ban Giám hiệu; \nb) Phòng Hành chính tổng hợp trình lịch công tác tuần của Ban Giám hiệu cho Hiệu trưởng quyết định chậm nhất vào 13h00’ thứ Sáu hằng tuần;\nc) Sau khi được phê duyệt, Phòng Hành chính tổng hợp thông báo lịch công tác tuần của Ban Giám hiệu đến các đồng chí trong Ban Giám hiệu, các đơn vị trước 15h00’ thứ Sán hằng tuần ( qua mạng LAN); \nd) Phòng Hành chính tổng hợp có trách nhiệm tham mưu Hiệu trưởng xây dựng, điều chỉnh và đôn đốc việc thực hiện lịch công tác tuần của Ban Giám hiệu. Trong trường hợp vì yêu cầu công tác, Hiệu trưởng chưa phê duyệt lịch công tác tuần của Ban Giám biệu trước 15h00' thứ Sáu hoặc có sự điều chinh, Phòng Hành chính tổng hợp có trách nhiệm thông báo kịp thời để Ban Giám hiệu, Thủ trưởng các đơn vi liên quan biết, thực hiện.\n", dieu:"Điều 23", khoan:5, entity:"Tuan"}}, {_id:34, properties:{answer:"1. Bảo đảm giải quyết công việc theo đúng thẩm quyền và phạm vi trách nhiệm được phân công: \n2. Chỉ tiến hành khi thực sự cần thiết và đã chuẩn bị kỹ về nội dung để phục vụ cho công tác chỉ đạo, điều hành của Ban Giám hiệu trong việc thực hiện các nhiệm vụ công tác quan trọng. Không dùng việc họp để thay cho việc ra các quyết định quản lý, điều hành; \n3. Xác định rõ mục đích, yêu cầu, nội dung, thành phần tham dự; đề cao và thực hiện nghiêm túc chế độ trách nhiệm cá nhân trong phân công và xử lý công việc, bảo đảm tăng cường hiệu lực, hiệu quả công tác chỉ đạo, điều hành tập trung thống nhất, thông suốt của Ban Giám hiệu; \n4. Theo chương trình kế hoạch; thực biện cải tiến, đơn giản hóa quy trình, thủ tục tiến hành, được bố trí hợp lý: bảo đảm chất lượng, hiệu quả, thiết thực, tiết kiệm, không hình thức, phô trương;\n5. Thực hiện lồng ghép các nội dung công việc cần xử lý; kết hợp các loại cuộc họp với nhau trong việc tổ chức họp một cách hợp lý; \n6. Phù hợp với tính chất, yêu cầu và nội dung công việc cần giải quyết; phù hợp với tính chất và đặc điểm về tổ chức và hoạt động của Trường; \n7. Phòng Hành chính tổng hợp chủ trì phục vụ Ban Giám hiệu tổ chức hội nghị giao ban lãnh đạo các đơn vị, hội nghị triển khai thực hiện các chủ trương chính sách chung của Đảng, Nhà nước và của Ngành; làm thư ký hội nghị và thông báo kết luận của Ban Giám hiệu cho các đơn vị có liên quan. \n8. Các hội nghị, cuộc họp chuyên đề, giao ban tháng trên các lĩnh vực do Ban Giám hiệu phụ trách quyết định phân công đơn vị chủ trì tham mưu. Đơn vị được phân công có trách nhiệm phối hợp với Phòng Hành chính tổng hợp để tham mưu, tổ chức và gửi Biên bản cuộc họp về Phòng Hành chính tổng hợp để tập hợp báo cáo Hiệu trưởng trong cuộc họp Bạn Thường vụ và giao ban quý.\n", dieu:"Điều 34"}}, {_id:36, properties:{answer:"1. Hội nghị, cuộc hop do Ban Giám hiệu chủ trì, gồm: \na) Hội nghị triển khai chương trình công tác năm học của Trường: \nb) Hội nghị giao ban tháng trên các lĩnh vực, giao ban tháng, quý, sơ kết học kỳ, tổng kết năm học của Trường; \nc) Hội nghị chuyên đề (triển khai, sơ kết, tổng kết một hoặc một số chuyên đề), hội nghị tập huấn công tác chuyên môn; \nd) Hội nghị cán bộ, giảng viên; hội nghị giao ban, đối thoại công tác quản lý giáo dục học viên; \ne) Họp các hội đồng tư vấn của Trường; \ng) Họp, làm việc với lãnh đạo các đơn vị trực thuộc Bộ Công an; với lãnh đạo chính quyền và Công an các địa phương; \nh) Các hội nghị, cuộc hop khác để giải quyết công việc.\n2. Các cuộc họp do Thủ trưởng đơn vị chủ trì, gồm: \na) Họp giao ban, sơ kết, tổng kết định kỳ (năm, học kỳ, quý; tháng, tuần); triển khai chương trình công tác năm học; các cuộc họp để giải quyết các công việc chuyên môn, chuyên đề, tập huấn và các công việc khác theo chức năng, nhiệm vụ của đơn vị. Chỉ huy cấp đội tổ chức cuộc họp giao ban hàng ngày. \nb) Thủ trưởng đơn vị có thể chủ trì các cuộc hợp, làm việc với đại diện các cơ quan liên quan theo ủy quyền của Hiệu trưởng hoặc Phó Hiệu trưởng phụ trách.\nc) Các đơn vị khi mời Hiệu trưởng hoặc Phó Hiệu trưởng phụ trách dự họp phải báo cáo xin phép trước khi tổ chức hop\nĐÂY LÀ NỘI DUNG CHỈNH SỬA\n", dieu:"Điều 35"}}, {_id:38, properties:{answer:"1. Hiệu trưởng quyết định các cuộc họp sau: \na) Hội nghị toàn trường triển khai chương trình công tác năm học; \nb) Hội nghị chuyên đề, tập huần; \nc) Họp giao ban tháng, quý, sơ kết học kỳ, tổng kết năm học; \nd) Ban Giám hiệu làm việc với lãnh đạo các đơn vị trực thuộc Bộ Công an; với lãnh đạo chính quyền và Công an các địa phương; \ne) Các cuộc họp khác để giải quyết công việc. \n2. Phó Hiệu trưởng quyết định các cuộc họp sau: \na) Họp, làm việc với các đơn vị, giao ban tháng đối với các lĩnh vực được giao phụ trách; \nb) Các cuộc họp khác dé giai quyết công việc do Phó Hiệu trưởng chủ trì.\n3. Thủ trưởng các đơn vị quyết định các cuộc họp do lãnh đạo đơn vị chủ trì để giải quyết các công việc chuyên môn và các công việc khác theo chức năng, nhiệm vụ của đơn vị theo quy định.\n", dieu:"Điều 37"}}, {_id:40, properties:{answer:"1. Xây dựng kế hoạch \nSau khi được Ban Giám hiệu duyệt cho tổ chức hội nghị, cuộc họp, đơn vị chủ trì chuẩn bị nội dung, xây dụng, kế hoạch để xin ý kiến Ban Giám hiệu về: \na) Nội dung hội nghị, cuộc hop, phân công chuẩn bị các báo cáo; \nb) Thành phần, thời gian, địa điểm; \nc) Dự trù kinh phí (nếu có); \nd) Dự kiến thành lập Ban Tổ chức (nếu có); \ne) Dự kiến chương trình; \ng)Dự kiến phương án bảo vệ bí mật nhà nước (nếu có); \nh) Các vấn đề cần thiết khác. \n2. Chuẩn bị và thông qua báo cáo \na) Đơn vị chủ trì được phân công dự thảo báo cáo và trình Hiệu trưởng hoặc Phó Hiệu trưởng, phụ trách duyệt. \nb) Thủ trưởng đơn vị được phân công có trách nhiệm kiểm tra kỹ về nội dung, hình thức các báo cáo, bài phát biểu của cấp trén (nếu có) trước khi trình Ban Giám hiệu duyệt. \n3. Tổ chức mời đại biểu \na) Thủ trưởng đơn vị chủ trì tổ chức hội nghị, cuộc họp phối hợp với Trưởng phòng Hành chính tổng hợp lên danh sách đại biểu khách mời, trình Ban Giám hiệu duyệt và gửi giấy mời theo thành phần đã được phê duyệt; \nb) Giấy mời lãnh đạo Bộ Công an, lãnh đạo các cơ quan, đơn vị ngoài “Trường dự họp phải do Ban Giám hiệu ký; \nc) Các đơn vị trực thuộc Trường, căn cứ vào lịch công tác tuần của Ban Giám hiệu để bố trí người dự đúng thành phần. \n4. Tổ chức hội nghị, cuộc họp \na) Đơn vị chủ trì hội nghị, cuộc họp thống kê danh sách đại biểu tham dự và các nội dung có liên quan để báo cáo lãnh đạo chủ trì hội nghị và xử lý những tình huống cần thiết khác;\nb) Tại hội nghị, cuộc họp, người chủ trì điều hành theo chương trình dự kiến. Tùy theo yêu cầu thực tế có thể quyết định điều chỉnh chương trình và thông báo cho người tham dự biết \nc) Người chủ trì điều hành hội nghị, cuộc hop phải kết luận rõ ràng về các nội dung, chuyên đề đã được thảo luận. \n5. Ghi biên bản và thông báo kết quả \nPhòng Hành chính tổng hợp hoặc đơn vị chủ trì tổ chức hội nghị, cuộc họp chịu trách nhiệm cử thư ký ghi biên bán và thông báo ý kiến kết luận của Ban Giám hiệu đến các đơn vị, cá nhân có liên quan. \n6. Báo cáo kết quả \na) Phó Hiệu trưởng báo cáo với Hiệu trưởng về kết quả hội nghị, cuộc họp do mình chủ trì sau khi kết thúc;\nb) Đối với hội nghị, cuộc họn do Ban Giám hiệu ủy quyền cho Thủ trưởng các đơn vị chủ trì, sau khi kết thúc, người được ủy quyền phải báo cáo Hiệu trưởng và Phó Hiệu trưởng phụ trách về kết quá hội nghị, cuộc họp và những vấn đề vượt quá thẩm quyền gỉải quyết của đơn vị.\n", dieu:"Điều 38"}}, {_id:42, properties:{answer:"1. Các nghi lễ được tổ chức tại Trường bao gồm: \na) Lễ chào cờ Tổ quốc;\nb) Lễ đón tiếp các đồng chí lãnh đạo Đảng, Nhà nước, lãnh đạo Bộ Công an và các đoàn khách quốc tế; \nc) Lễ trao tặng và đón nhận huân chương, huy chương, danh hiệu vinh dự nhà nước và các hình thức khen thưởng khác;\nd) Lễ tuyên thệ; lễ vinh danh chức danh giáo sư, phó giáo sư và trình độ tiến sĩ; lễ công bố quyết định về công tác cán bộ; \ne) Lễ kỷ niệm ngày thành lập, ngày truyền thống;\ng) Lễ khai giảng, bế giảng; \nh) Lễ khai mac, bế mạc hội thi, hội thao; \ni) Lễ dâng hoa, dâng hương Chủ tịch Hồ Chi Minh, tưởng niệm các anh hùng liệt sĩ, các vị lãnh tụ, các danh nhân Văn hóa tiêu biểu của dân tộc; \nk) Lễ khởi công, khánh thành các công trình mới xây dựng; \n1) Lễ tang trong Công an nhân dân; \nm) Các nghi lễ khác do Hiệu trưởng quyết định. \n2. Hình thức, nguyên tắc, trình tự tổ chức các nghi lễ tại Trường thực hiện theo Thông tư số 36/2019/TT-BCA ngày 18/9/2019 của Bộ Công an quy định về nghi lễ Công an nhân dân; Thông tư số 24/2024/TT-BCA ngày 21/6/2024 của Bộ Công an quy định về tổ chức kỷ niệm ngày thành lập, ngày truyền thống trong Công an nhân dân và được vận dụng vào tình hình thực tế do Hiệu trưởng quyết định.\n", dieu:"Điều 41"}}, {_id:44, properties:{answer:"1. Phối hợp với Phòng Chính trị, Phòng Quản lý học viên trong việc tiếp cán bộ, chiến sĩ, xử lý các khiếu nại, tố cáo, phản ánh, kiến nghị của cán bộ, chiến sĩ. \n2. Cử cán bộ có chuyên môn theo đúng yêu cầu của Ban Giám hiệu để cùng phối hợp tiếp cán bộ, chiến sĩ; cử cán bộ tham gia đoàn thanh tra, kiểm tra xử lý các vụ việc cụ thể theo chỉ đạo của Ban Giám hiệu. \n3. Cung cấp hồ sơ, tài liệu liên quan đến việc khiếu nại, tổ cáo của cán bộ, chiến sĩ để các đơn vị chức năng tham mưu Ban Giám hiệu trả lời những khiếu nại, tố cáo của cán bộ, chiến sĩ.\n", dieu:"Điều 50", text:"Căn cứ Điều 50:\n1. Phối hợp với Phòng Chính trị, Phòng Quản lý học viên trong việc tiếp cán bộ, chiến sĩ, xử lý các khiếu nại, tố cáo, phản ánh, kiến nghị của cán bộ, chiến sĩ. \n2. Cử cán bộ có chuyên môn theo đúng yêu cầu của Ban Giám hiệu để cùng phối hợp tiếp cán bộ, chiến sĩ; cử cán bộ tham gia đoàn thanh tra, kiểm tra xử lý các vụ việc cụ thể theo chỉ đạo của Ban Giám hiệu. \n3. Cung cấp hồ sơ, tài liệu liên quan đến việc khiếu nại, tổ cáo của cán bộ, chiến sĩ để các đơn vị chức năng tham mưu Ban Giám hiệu trả lời những khiếu nại, tố cáo của cán bộ, chiến sĩ.\n", entity:"ThuTruong"}}, {_id:46, properties:{answer:"test"}}, {_id:49, properties:{answer:"1. Chỉ đạo của Đảng, Nhà nước, Bộ Công an, Bộ Giáo dục và Đào tạo; yêu cầu của các đơn vị chức năng trực thuộc Bộ Công an, Công an các địa phương; cấp ủy, chính quyền địa phương;\n2. Chương trình công tác của Bộ Công an; chỉ tiêu công tác của Bộ Công an giao cho Trường; chức năng, nhiệm vụ, khả năng, tiềm lực của Trường và yêu cầu, tinh hình công tác thực tiễn;\n3. Đề xuất bằng văn bản của các đơn vị trực thuộc Trường được Ban Giám hiệu chấp thuận;\n4. Riêng chương trình công tác tuần của Ban Giám hiệu xây dựng căn cứ vào lịch họp và yêu cầu thực tiễn hoạt động lãnh đạo, chỉ đạo, điều hành của Ban Giám hiệu.\n", dieu:"Điều 22"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Answer;
UNWIND [{_id:51, properties:{answer:"1. Đối với những văn bản đã soạn thảo đúng quy định, bộ phận văn thư sẽ trình Ban Giám hiệu vào đầu giờ của mỗi buổi làm việc. Đối với văn bản khẩn, bộ phận văn thư sẽ trình Ban Giám hiệu ngay khi tiếp nhận hồ sơ văn bản trình duyệt, ký của các đơn vị. \n2. Hằng ngày, bộ phận văn thư nhận văn bản đã duyệt, ký của Ban Giám hiệu vào lúc 10h00” và lúc 14h00”. Sau đó trả ngay cho đơn vị trình ký tại phòng làm việc của bộ phận văn thư. \n3. Văn bản trình sẽ được Ban Giám hiệu duyệt, ký tối đa trong thời gian 02 ngày làm việc. Trường hợp đặc biệt, Ban Giám hiệu sẽ chỉ đạo Phòng Hành chính tổng hợp thông báo với đơn vị có văn bản trình duyệt, ký.\n", dieu:"Điều 29"}}, {_id:53, properties:{answer:"1. Hiệu trưởng có thẩm quyền duyệt, ký tất cả các văn bản của Trường.\n2. Phó Hiệu trưởng có thẩm quyền duyệt, ký các văn bản theo sự phân công, ủy quyền của Hiệu trưởng trên các lĩnh vực phụ trách. \n3. Thủ trưởng đơn vị có thẩm quyền duyệt, ký thừa lệnh, ký thừa ủy quyền của Hiệu trưởng một số văn bản được Hiệu trưởng ủy quyền giải quyết công việc theo chức năng, nhiệm vụ được giao. Thủ trưởng các đơn vị: Phòng Hành chính tổng hợp, Phòng Chính trị, Phòng Quản lý đào tạo và bồi dưỡng nâng cao, Phòng Bảo đảm chất lượng đào tạo, Phòng Quản lý nghiên cứu khoa học, Phòng Quản lý học viên, Phòng Hậu cần được sử dụng con dấu khi thừa lệnh, thừa ủy quyền Hiệu trưởng.\n", dieu:"Điều 30"}}, {_id:56, properties:{answer:"1. Tùy theo công việc, Hiệu trưởng bố trí thời gian tiếp hoặc ủy quyền cho Phó Hiệu trưởng tiếp cán bộ, chiến sĩ.\n2. Chỉ đạo Trưởng phòng Chính trị, Trưởng phòng Quản lý học viên, Thủ trưởng các đơn vị có liên quan phối hợp thực hiện nghiêm túc nhiệm vụ tiếp cán bộ, chiến sĩ đến khiếu nại, tố cáo, phản ánh, kiến nghị; kịp thời giải quyết theo thẩm quyền các khiếu nại, tố cáo; trân trọng lắng nghe ý kiến của cán bộ, chiến sĩ để cải tiến, nâng cao chất lượng, hiệu quả công tác.", dieu:"Điều 49", entity:"HieuTruong"}}, {_id:78, properties:{answer:"1. Công tác bổ nhiệm, miễn nhiệm, bãi nhiệm các chức danh giảng dạy phải bảo đảm công khai, dân chủ, giữ vững đoàn kết nội bộ, phát huy trách nhiệm của lãnh đạo đơn vị và của Hội đồng chức danh giảng dạy các cấp. \n2. Bảo đảm sự ổn định, kế thừa và phát triển của từng chức danh phù hợp với yêu cầu phát triển, quy mô của từng đơn vị làm công tác giảng dạy và cơ sở giáo dục. \n3. Chỉ xét bổ nhiệm chức danh giảng dạy quy định tại Thông tư này đối với nhà giáo thuộc biên chế cơ hữu của đơn vị làm công tác giảng dạy; nhà giáo được bổ nhiệm chức danh giảng dạy phải bảo đảm tiêu chuẩn chung và tiêu chuẩn cụ thể của từng chức danh giảng dạy được quy định tại Thông tư này. Nhà giáo giảng dạy nhiều trình độ đào tạo khác nhau thì bổ nhiệm chức danh theo trình độ đào tạo cao nhất hoặc giảng dạy trình độ đào tạo nào thì bổ nhiệm chức danh ở trình độ đào tạo đó. \n4. Không xét bổ nhiệm chức danh giảng dạy đối với trường hợp đang trong thời gian xem xét xử lý kỷ luật hoặc chấp hành kỷ luật. ", dieu:"Điều 2"}}, {_id:79, properties:{answer:"1. Bảo đảm tiêu chuẩn của nhà giáo quy định tại Luật Giáo dục ngày 14 tháng 6 năm 2019 và tiêu chuẩn chung về đạo đức nghề nghiệp theo quy định của Bộ Giáo dục và Đào tạo, Bộ Lao động - Thương binh và Xã hội. \n2. Có trình độ trung cấp lý luận chính trị hoặc tương đương trở lên; nhà giáo giảng dạy thực hành có trình độ sơ cấp lý luận chính trị hoặc tương đương \ntrở lên. \n3. Có chứng chỉ bồi dưỡng nghiệp vụ sư phạm tương đương với trình độ đào tạo theo quy định của Bộ Giáo dục và Đào tạo hoặc có bằng tốt nghiệp khoa sư phạm theo ngành, chuyên ngành. \n4. Trình độ ngoại ngữ \na) Bảo đảm trình độ ngoại ngữ theo Khung năng lực ngoại ngữ 6 bậc dùng cho Việt Nam của Bộ Giáo dục và Đào tạo (sau đây gọi chung là Khung ngoại ngữ 6 bậc) hoặc tương đương theo từng chức danh giảng dạy quy định tại Thông tư này hoặc có bằng cử nhân ngoại ngữ hoặc đã học tập, nghiên cứu toàn thời gian ở nước ngoài được cấp bằng tốt nghiệp đại học, bằng thạc sĩ, bằng tiến sĩ của cơ sở đào tạo nước ngoài; \nb) Nhà giáo giảng dạy ngoại ngữ bảo đảm trình độ ngoại ngữ thứ hai theo Khung ngoại ngữ 6 bậc hoặc tương đương theo từng chức danh giảng dạy quy định tại Thông tư này hoặc có bằng cử nhân ngoại ngữ thứ hai; \nc) Nhà giáo giảng dạy thực hành có chứng chỉ ngoại ngữ bậc 1 hoặc tương đương trở lên. \n5. Bảo đảm Chuẩn kỹ năng sử dụng công nghệ thông tin theo quy định của Bộ Thông tin và Truyền thông theo từng chức danh giảng dạy quy định tại Thông tư này hoặc có bằng trung cấp trở lên các chuyên ngành liên quan đến tin học, công nghệ thông tin. \n6. Nhà giáo tốt nghiệp các trường ngoài Công an nhân dân tham gia giảng dạy nghiệp vụ có văn bằng 2 đại học Công an trở lên hoặc tham gia giảng dạy các lĩnh vực khác có chứng chỉ bồi dưỡng pháp luật, nghiệp vụ 06 tháng trở lên. \n7. Đã hoàn thành nhiệm vụ đi thực tế theo quy định. ", dieu:"Điều 3"}}, {_id:86, properties:{answer:"1. Giám đốc, hiệu trưởng cơ sở giáo dục đại học, hiệu trưởng cơ sở giáo dục nghề nghiệp trong Công an nhân dân (sau đây gọi chung là Hiệu trưởng) quyết định bổ nhiệm, miễn nhiệm, bãi nhiệm các chức danh giảng dạy ở cơ sở giáo dục thuộc thẩm quyền quản lý. \n2. Việc bổ nhiệm chức danh Giảng viên chính, Giáo viên cao cấp chỉ được thực hiện sau khi có quyết định công nhận đạt tiêu chuẩn chức danh giảng dạy của Chủ tịch Hội đồng chức danh giảng dạy Bộ Công an. ", dieu:"Điều 14"}}, {_id:87, properties:{answer:"Các trường hợp bổ nhiệm \na) Bổ nhiệm theo tiêu chuẩn chung và tiêu chuẩn cụ thể của các chức danh giảng dạy; \nb) Trường hợp đã miễn nhiệm chức danh giảng dạy do điều động, chuyển công tác khác, sau khi được điều động trở lại làm công tác giảng dạy thuộc biên chế cơ hữu của đơn vị làm công tác giảng dạy, nếu bảo đảm tiêu chuẩn của chức danh nào thì bổ nhiệm chức danh đó (trừ tiêu chuẩn đảm nhiệm chức danh giảng dạy liên tục tính đến thời điểm đăng ký xét bổ nhiệm) và được bảo lưu thời gian đảm nhiệm chức danh trước khi miễn nhiệm; \nc) Trường hợp trong niên hạn đảm nhiệm chức danh giảng dạy, nếu có 01 năm học xếp loại cán bộ không hoàn thành nhiệm vụ hoặc bị kỷ luật thì phải kéo dài niên hạn từ đủ 12 tháng trở lên mới được xem xét bổ nhiệm; \nd) Trường hợp đã được bổ nhiệm chức danh giảng dạy trước khi được tuyển chọn hoặc điều động làm công tác giảng dạy thuộc biên chế cơ hữu của đơn vị làm công tác giảng dạy, nếu bảo đảm tiêu chuẩn của chức danh nào thì bổ nhiệm chức danh đó (trừ tiêu chuẩn đảm nhiệm chức danh giảng dạy liên tục tính đến thời điểm đăng ký xét bổ nhiệm); nếu chưa được bổ nhiệm chức danh giảng dạy thì phải xét từ tập sự giảng dạy để bổ nhiệm từng chức danh theo quy định; \nđ) Trường hợp đang công tác trong Công an nhân dân được điều động làm công tác giảng dạy thuộc biên chế cơ hữu của đơn vị làm công tác giảng dạy, nếu là nhà giáo thỉnh giảng đã có ít nhất 02 năm học liên tục giảng dạy theo đúng đối tượng, trình độ đào tạo, lĩnh vực giảng dạy, hoàn thành định mức giờ thỉnh giảng thì không phải tập sự giảng dạy hoặc đã có 05 năm học liên tục giảng dạy theo đúng đối tượng, trình độ đào tạo, lĩnh vực giảng dạy, hoàn thành định mức giờ thỉnh giảng, nếu bảo đảm tiêu chuẩn của một trong các chức danh: Trợ giảng, Giảng viên, Giáo viên, Giáo viên chính thì bổ nhiệm chức danh đó (trừ tiêu chuẩn đảm nhiệm chức danh giảng dạy liên tục tính đến thời điểm đăng ký xét bổ nhiệm); \ne) Trường hợp miễn nhiệm do có 02 năm học liên tục xếp loại cán bộ không hoàn thành nhiệm vụ quy định tại điểm a khoản 2 Điều này, sau thời hạn ít nhất là 24 tháng kể từ ngày có quyết định miễn nhiệm, nếu các năm học sau khi bị miễn nhiệm đều được xếp loại cán bộ từ hoàn thành tốt nhiệm vụ trở lên, có đủ tiêu chuẩn theo quy định và có nguyện vọng được xét bổ nhiệm chức danh giảng dạy thì được xem xét điều động làm công tác giảng dạy thuộc biên chế cơ hữu của đơn vị làm công tác giảng dạy và bổ nhiệm lại chức danh giảng dạy trước khi miễn nhiệm; \ng) Trường hợp chỉ giảng dạy thực hành thì chỉ được xét, bổ nhiệm chức danh Trợ giảng hoặc Giáo viên. ", dieu:"Điều 15", entity:"BoNhiem"}}, {_id:88, properties:{answer:"Các trường hợp miễn nhiệm, bãi nhiệm \na) Căn cứ miễn nhiệm: Không tiếp tục làm công tác giảng dạy do chuyển ngành, xuất ngũ hoặc điều động đến Công an đơn vị, địa phương; không có nguyện vọng tiếp tục tham gia giảng dạy hoặc không tiếp tục được giao nhiệm vụ giảng dạy khi có quyết định điều động đến đơn vị không làm công tác giảng dạy thuộc cơ sở giáo dục; có 03 năm học liên tục không giảng dạy (trừ các trường hợp: được cử đi đào tạo dài hạn tập trung liên tục; đi luân chuyển có thời hạn theo quy định của Bộ Công an; thực hiện nhiệm vụ tại Công an đơn vị, địa phương theo quyết định của cấp có thẩm quyền) hoặc có 02 năm học liên tục xếp loại cán bộ không hoàn thành nhiệm vụ; \nb) Căn cứ bãi nhiệm: Vi phạm các quy chế, quy định về giáo dục, đào tạo, về đạo đức, tư cách nhà giáo, vi phạm pháp luật hoặc các vi phạm khác dẫn đến xử lý kỷ luật theo quy định của Bộ Công an (các trường hợp bị tước danh hiệu Công an nhân dân, bị khởi tố thì đương nhiên bãi nhiệm); \nc) Các trường hợp miễn nhiệm, bãi nhiệm chức danh giảng dạy nếu thuộc biên chế cơ hữu của đơn vị làm công tác giảng dạy thì Hiệu trưởng quyết định điều chuyển công tác khác và ban hành quyết định miễn nhiệm, bãi nhiệm, trong quyết định phải nêu rõ căn cứ miễn nhiệm, bãi nhiệm.", dieu:"Điều 15", entity:"BaiNhiem, MienNhiem"}}, {_id:89, properties:{answer:"Thời điểm xét bổ nhiệm chức danh giảng dạy \nViệc xét, bổ nhiệm các chức danh giảng dạy được thực hiện định kỳ hằng năm và đột xuất theo yêu cầu, tình hình thực tế. \na) Xét, bổ nhiệm chức danh Trợ giảng, Giảng viên, Giáo viên, Giáo viên chính tại Hội đồng cấp trường từ ngày 01/7 đến ngày 15/8; xét, công nhận đạt tiêu chuẩn chức danh Giảng viên chính, Giáo viên cao cấp tại Hội đồng cấp trường từ ngày 01/7 đến ngày 05/8, tại Hội đồng chức danh giảng dạy Bộ Công an (sau đây viết gọn là Hội đồng cấp Bộ) từ ngày 15/8 đến ngày 31/10; bổ nhiệm chức danh Giảng viên chính, Giáo viên cao cấp trước ngày 20/11; \nb) Trường hợp được tuyển chọn, điều động làm công tác giảng dạy và trường hợp đề nghị xét, bổ nhiệm chức danh Trợ giảng, Giáo viên trong năm học không cùng thời điểm quy định tại điểm a khoản 1 Điều này, trong thời gian 20 ngày làm việc, tính từ ngày Thường trực Hội đồng cấp trường nhận được đầy đủ hồ sơ đăng ký xét bổ nhiệm chức danh giảng dạy và 10 ngày làm việc, tính từ ngày Thường trực Hội đồng cấp Bộ nhận được đầy đủ hồ sơ đề nghị xét, bổ nhiệm chức danh giảng dạy của cơ sở giáo dục; bổ nhiệm chức danh Giảng viên chính, Giáo viên cao cấp chậm nhất 10 ngày sau khi nhận được quyết định công nhận đạt tiêu chuẩn chức danh; \nc) Trường hợp cần phải xác minh, làm rõ hoặc báo cáo, xin ý kiến thì được cộng thêm thời gian theo thực tế phát sinh cần thiết. ", dieu:"Điểu 16", khoan:1, entity:"BoNhiem"}}, {_id:90, properties:{answer:"Thời điểm miễn nhiệm chức danh giảng dạy \na) Miễn nhiệm chức danh giảng dạy đối với trường hợp chuyển ngành, xuất ngũ hoặc điều động công tác không tiếp tục làm công tác giảng dạy được thực hiện đồng thời, có hiệu lực cùng ngày với hiệu lực thi hành của quyết định chuyển ngành, xuất ngũ, điều động; \nb) Miễn nhiệm chức danh giảng dạy đối với trường hợp có 03 năm học liên tục không giảng dạy, được thực hiện trong 05 ngày làm việc, tính từ ngày kết thúc năm học thứ ba; \nc) Miễn nhiệm chức danh giảng dạy đối với trường hợp có 02 năm học liên tục xếp loại cán bộ không hoàn thành nhiệm vụ, được thực hiện trong 05 ngày làm việc, tính từ ngày có kết quả xếp loại cán bộ năm học thứ hai của cấp có thẩm quyền. ", dieu:"Điểu 16", khoan:2, entity:"MienNhiem"}}, {_id:91, properties:{answer:"Thời điểm bãi nhiệm chức danh giảng dạy đối với trường hợp quy định tại điểm b khoản 2 Điều 15 được thực hiện đồng thời, có hiệu lực cùng ngày với hiệu lực thi hành của quyết định xử lý vi phạm, kỷ luật.", dieu:"Điều 16", khoan:3, entity:"BaiNhiem"}}, {_id:92, properties:{answer:"1. Hồ sơ xét miễn nhiệm, bãi nhiệm gồm: \na) Báo cáo của đơn vị làm công tác giảng dạy về lý do miễn nhiệm, bãi nhiệm chức danh giảng dạy; \nb) Biên bản họp đơn vị và những tài liệu liên quan làm căn cứ xét. \n2. Trường hợp chuyển ngành, xuất ngũ, điều động công tác không tiếp tục tham gia giảng dạy và đương nhiên bãi nhiệm thì không phải thiết lập hồ sơ. \n3. Thủ tục xét miễn nhiệm, bãi nhiệm gồm: \na) Người đứng đầu đơn vị làm công tác giảng dạy tổ chức họp đơn vị, xây dựng báo cáo, biên bản họp đơn vị gửi Thường trực Hội đồng cấp trường (qua Phòng Tổ chức cán bộ/Phòng Chính trị/Phòng Chính trị và Quản lý học viên); \nb) Thường trực Hội đồng cấp trường thẩm định và hoàn chỉnh hồ sơ, báo cáo đề nghị Hiệu trưởng ra quyết định miễn nhiệm, bãi nhiệm; \nc) Đối với các trường hợp chuyển ngành, xuất ngũ, điều động công tác \nkhông tiếp tục tham gia giảng dạy và đương nhiên bãi nhiệm: căn cứ quyết định chuyển ngành, xuất ngũ, điều động, kỷ luật, Thường trực Hội đồng cấp trường báo cáo, đề nghị Hiệu trưởng ra quyết định miễn nhiệm, bãi nhiệm (không phải tổ chức họp theo quy định tại điểm a khoản 3 Điều này).", dieu:"Điều 22"}}, {_id:103, properties:{answer:"1. Nhiệm vụ: Thực hiện các nhiệm vụ quy định tại Điều 4 Thông tư này. \n2. Tiêu chuẩn về trình độ đào tạo, bồi dưỡng \na) Có bằng tốt nghiệp đại học trở lên phù hợp với chuyên môn giảng dạy. Giảng dạy quân sự, võ thuật có bằng tốt nghiệp đại học trở lên, ngành, chuyên ngành được đào tạo đúng với chuyên môn giảng dạy hoặc có bằng tốt nghiệp đại học trở lên và một trong các văn bằng, chứng chỉ sau: bằng trung cấp chuyên ngành Huấn luyện viên quân sự, võ thuật trong Công an nhân dân; chứng chỉ bồi dưỡng quân sự, võ thuật. Giảng dạy thực hành có bằng cao đẳng trở lên phù hợp với chuyên môn giảng dạy và có giấy phép hoặc chứng chỉ kỹ năng nghề phù hợp với vị trí việc làm đang đảm nhiệm; \nb) Có chứng chỉ ngoại ngữ bậc 2 trở lên. Giảng dạy ngoại ngữ có chứng chỉ ngoại ngữ thứ hai đạt bậc 2 trở lên; \nc) Có chứng chỉ tin học đạt Chuẩn kỹ năng sử dụng công nghệ thông tin cơ bản hoặc tương đương trở lên. \n3. Tiêu chuẩn về năng lực chuyên môn, nghiệp vụ \na) Đã có thời gian tập sự giảng dạy từ đủ 12 tháng đến không quá 48 tháng (không quá 60 tháng đối với trường hợp được tuyển chọn từ ngoài ngành Công an), được Hội đồng duyệt giảng cấp trường đánh giá đạt yêu cầu và đủ khả năng giảng dạy. Thời gian tập sự giảng dạy để bổ nhiệm chức danh Trợ giảng không tính thời gian đi luân chuyển có thời hạn; đi thực tế; nghỉ sinh con theo chế độ bảo hiểm xã hội; nghỉ ốm hoặc điều trị bệnh từ 14 ngày trở lên theo kết luận của cơ quan, đơn vị y tế có thẩm quyền; nghỉ hè, lễ, tết; nghỉ không hưởng lương; tạm đình chỉ công tác theo quy định; \nb) Nắm vững kiến thức các học phần được phân công giảng dạy và có kiến thức tổng quát về một số học phần có liên quan trọng chuyên ngành đào tạo được đảm nhiệm; \nc) Nắm vững mục tiêu, kế hoạch, nội dung, chương trình đào tạo; \nd) Có năng lực biên soạn giáo án, tập hợp các tài liệu tham khảo liên quan của học phần được phân công giảng dạy; \nđ) Có năng lực tổ chức cho học viên nghiên cứu khoa học; ứng dụng, triển khai những kết quả nghiên cứu khoa học vào công tác giáo dục, đào tạo và thực tiễn công tác của Công an nhân dân; \ne) Sử dụng thành thạo và an toàn các phương tiện dạy học, trang thiết bị dạy học; có phương pháp dạy học phù hợp. ", dieu:"Điều 5", entity:"TroGiang"}}, {_id:104, properties:{answer:"1. Nhiệm vụ \nGiảng viên thực hiện các nhiệm vụ quy định tại Điều 4 Thông tự này và các nhiệm vụ sau: \na) Tham gia giảng dạy chương trình đào tạo trình độ thạc sĩ, tiến sĩ và hướng dẫn, đánh giá luận văn thạc sĩ, luận án tiến sĩ nếu đủ tiêu chuẩn theo quy định; hướng dẫn và chấm đồ án, khóa luận tốt nghiệp trình độ đại học; \nb) Tham gia xây dựng mục tiêu, kế hoạch, nội dung, chương trình đào tạo; c) Chủ trì biên soạn chương trình giáo dục, giáo trình, tài liệu dạy học nếu đủ điều kiện theo quy định; \nd) Chủ trì các hoạt động nghiên cứu khoa học. \n2. Tiêu chuẩn về trình độ đào tạo, bồi dưỡng \na) Có bằng thạc sĩ trở lên phù hợp với lĩnh vực, chuyên môn giảng dạy. Nhà giáo giảng dạy quân sự, võ thuật có bằng thạc sĩ trở lên phù hợp với lĩnh vực, chuyên môn giảng dạy hoặc thuộc nhóm ngành An ninh và trật tự xã hội, Tội phạm học và Phòng ngừa tội phạm và có chứng chỉ bồi dưỡng quân sự, võ thuật; \nb) Bảo đảm các tiêu chuẩn quy định tại các điểm b và c khoản 2 Điều 5 Thông tư này. \n3. Tiêu chuẩn về năng lực chuyên môn, nghiệp vụ \na) Đã đảm nhiệm chức danh Trợ giảng từ đủ 36 tháng trở lên hoặc từ đủ 24 tháng nếu có bằng tiến sĩ, trong đó có ít nhất 12 tháng liên tục tính đến ngày hết thời hạn nộp hồ sơ đăng ký xét bổ nhiệm chức danh tại Hội đồng chức danh giảng dạy cấp trường (sau đây viết gọn là Hội đồng cấp trường); \nb) Nắm vững kiến thức, kỹ năng chuyên môn các học phần được phân công giảng dạy và có kiến thức tổng quát về một số học phần có liên quan trọng chuyên ngành đào tạo được giao đảm nhiệm; \nc) Nắm vững mục tiêu, kế hoạch, nội dung, chương trình các môn học thuộc chuyên ngành đào tạo; xác định được thực tiễn và xu thế phát triển đào tạo, nghiên cứu của chuyên ngành; \nd) Có kĩ năng biên soạn giáo án, tổng hợp các tài liệu tham khảo liên quan của học phần được phân công giảng dạy; \nđ) Sử dụng thành thạo, có hiệu quả và an toàn các phương tiện dạy học, trang thiết bị dạy học; có phương pháp dạy học hiệu quả, phù hợp với nội dung học phần được phân công giảng dạy; giảng dạy đạt yêu cầu trở lên; \ne) Có năng lực tổ chức, chỉ đạo, hướng dẫn cho học viên nghiên cứu khoa học; ứng dụng, triển khai những kết quả nghiên cứu khoa học vào công tác giáo dục, đào tạo và thực tiễn công tác của Công an nhân dân.", dieu:"Điều 6", entity:"GiangVien"}}, {_id:105, properties:{answer:"1. Nhiệm vụ \nGiảng viên chính thực hiện các nhiệm vụ quy định tại Điều 4, các điểm a, c và d khoản 1 Điều 6 Thông tư này và các nhiệm vụ sau: \na) Chủ trì hoặc tham gia xây dựng mục tiêu, kế hoạch, nội dung, chương trình đào tạo; đề xuất chủ trương, phương hướng và biện pháp phát triển của ngành hoặc chuyên ngành được giao đảm nhiệm; \nb) Chủ động đề xuất các giải pháp nâng cao chất lượng giảng dạy, phương pháp kiểm tra đánh giá kết quả học tập, rèn luyện của học viên; \nc) Chủ trì hoặc tham gia đánh giá các dự án, đề án, đề tài nghiên cứu khoa học. \n2. Tiêu chuẩn về trình độ đào tạo, bồi dưỡng \na) Có bằng thạc sĩ trở lên phù hợp với lĩnh vực, chuyên môn giảng dạy. Nhà giáo giảng dạy quân sự, võ thuật có bằng thạc sĩ trở lên phù hợp với lĩnh vực, chuyên môn giảng dạy hoặc thuộc nhóm ngành An ninh và trật tự xã hội, Tội phạm học và Phòng ngừa tội phạm và có chứng chỉ bồi dưỡng quân sự, võ thuật; giảng dạy võ thuật có chứng chỉ bồi dưỡng võ thuật nâng cao; \nb) Có chứng chỉ bồi dưỡng tiêu chuẩn chức danh Giảng viên chính; \nc) Có chứng chỉ ngoại ngữ bậc 3 trở lên. Nhà giáo giảng dạy ngoại ngữ có chứng chỉ ngoại ngữ thứ hai đạt bậc 3 trở lên; \nd) Có chứng chỉ tin học đạt Chuẩn kỹ năng sử dụng công nghệ thông tin nâng cao hoặc tương đương. \n3. Tiêu chuẩn về năng lực chuyên môn, nghiệp vụ \na) Đã đảm nhiệm chức danh Giảng viên từ đủ 60 tháng trở lên hoặc từ đủ 48 tháng nếu có bằng tiến sĩ, trong đó có ít nhất 24 tháng liên tục tính đến ngày hết thời hạn nộp hồ sơ đăng ký xét bổ nhiệm chức danh tại Hội đồng cấp trường; \nb) Có kiến thức vững vàng và kỹ năng chuyên sâu về các học phần được phân công giảng dạy và có kiến thức cơ bản của một số học phần có liên quan trong chuyên ngành đào tạo được giao đảm nhiệm; \nc) Nắm vững mục tiêu, nội dung, chương trình các học phần được phân công đảm nhiệm; nắm bắt yêu cầu thực tiễn đối với chuyên ngành đào tạo; \nd) Có năng lực tổ chức, chỉ đạo tập thể nhà giáo, học viên nghiên cứu khoa học; ứng dụng, triển khai những kết quả nghiên cứu khoa học vào công tác giáo dục, đào tạo và thực tiễn công tác của Công an nhân dân; \nđ) Giảng dạy được ít nhất 01 học phần hoặc nội dung bài giảng có khối lượng kiến thức ít nhất bằng 03 tín chỉ; \ne) Đã hoàn thành thời gian đi luân chuyển có thời hạn đến đơn vị thuộc cơ quan Bộ Công an, Công an tỉnh, thành phố trực thuộc Trung ương (sau đây gọi chung là Công an đơn vị, địa phương) theo quy định; \ng) Tổng điểm quy đổi các công trình khoa học và thành tích dạy giỏi (sau đây viết gọn là tổng điểm quy đổi) đạt từ 8,0 điểm trở lên, trong đó có ít nhất 1,5 điểm hoạt động dạy giỏi và ít nhất 4,5 điểm công trình khoa học, hướng dẫn, huấn luyện; trong 03 năm học cuối tính đến thời điểm hết hạn nộp hồ sơ tại Hội đồng cấp trường có ít nhất 3,0 điểm công trình khoa học, hướng dẫn, huấn luyện. Nhà giáo giảng dạy võ thuật, giáo dục quốc phòng, giáo dục thể chất có tổng điểm quy đổi đạt từ 7,0 điểm trở lên, trong đó có ít nhất 1,5 điểm hoạt động dạy giỏi và ít nhất 3,5 điểm công trình khoa học, hướng dẫn, huấn luyện; trong 03 năm học cuối tính đến thời điểm hết hạn nộp hồ sơ tại Hội đồng cấp trường có ít nhất 2,5 điểm công trình khoa học, hướng dẫn, huấn luyện. ", dieu:"Điều 7", entity:"GiangVienChinh"}}, {_id:106, properties:{answer:"1. Nhiệm vụ: Thực hiện các nhiệm vụ quy định tại Điều 8 Thông tư này. \n2. Tiêu chuẩn về trình độ đào tạo, bồi dưỡng \na) Có bằng tốt nghiệp đại học trở lên phù hợp với chuyên môn giảng dạy. Giảng dạy quân sự, võ thuật có bằng tốt nghiệp đại học trở lên, ngành, chuyên ngành được đào tạo đúng với chuyên môn giảng dạy hoặc có bằng tốt nghiệp đại học trở lên và một trong các văn bằng, chứng chỉ sau: bằng trung cấp chuyên ngành Huấn luyện viên quân sự, võ thuật trong Công an nhân dân; chứng chỉ bồi dưỡng quân sự, võ thuật. Giảng dạy thực hành có bằng trung cấp trở lên phù hợp với chuyên môn giảng dạy và có giấy phép hoặc chứng chỉ kỹ năng nghề phù hợp với vị trí việc làm đang đảm nhiệm; \nb) Có chứng chỉ ngoại ngữ bậc 2 trở lên; giảng dạy ngoại ngữ có chứng chỉ ngoại ngữ thứ hai đạt bậc 2 trở lên; \nc) Có chứng chỉ tin học đạt Chuẩn kỹ năng sử dụng công nghệ thông tin cơ bản hoặc tương đương trở lên. \n3. Tiêu chuẩn về năng lực, chuyên môn nghiệp vụ \na) Đã có thời gian tập sự giảng dạy từ đủ 12 tháng đến không quá 48 tháng (không quá 60 tháng đối với trường hợp được tuyển chọn từ ngoài ngành Công an), được Hội đồng duyệt giảng cấp trường đánh giá đạt yêu cầu và đủ khả năng giảng dạy. Thời gian tập sự giảng dạy để bổ nhiệm chức danh Giáo viên không tính thời gian đi luân chuyển có thời hạn; đi thực tế; nghỉ sinh con theo chế độ bảo hiểm xã hội; nghỉ ốm hoặc điều trị bệnh từ 14 ngày trở lên theo kết luận của cơ quan, đơn vị y tế có thẩm quyền; nghỉ hè, lễ, tết; nghỉ không hưởng lương; tạm đình chỉ công tác theo quy định; \nb) Nắm vững kiến thức các môn học chính và kiến thức cơ bản một số môn học có liên quan trọng chuyên ngành đào tạo được đảm nhiệm; \nc) Nắm vững mục tiêu, kế hoạch, nội dung, chương trình đào tạo; \nd) Có năng lực nghiên cứu khoa học; ứng dụng, triển khai những kết quả nghiên cứu khoa học vào công tác giáo dục, đào tạo và thực tiễn công tác của Công an nhân dân. ", dieu:"Điểu 9", entity:"GiaoVien"}}, {_id:107, properties:{answer:"1. Nhiệm vụ \nGiáo viên chính thực hiện các nhiệm vụ quy định tại Điều 8 Thông tư này và các nhiệm vụ sau: \na) Chủ trì biên soạn chương trình giáo dục, giáo trình, tài liệu dạy học nếu đủ điều kiện theo quy định; \nb) Chủ trì tổng kết, đúc rút kinh nghiệm về phương pháp đào tạo; \nc) Chủ trì tổ chức, hướng dẫn đánh giá kết quả học tập; đánh giá kết quả thi tốt nghiệp của học viên; \nd) Chủ trì nghiên cứu khoa học, báo cáo khoa học, ứng dụng kỹ thuật, công nghệ, cải tiến phương tiện, thiết bị dạy học, trao đổi kinh nghiệm giảng dạy trình độ trung cấp; tổ chức xây dựng và quản lý phòng học chuyên môn; viết và tham gia báo cáo khoa học tại các hội nghị, hội thảo khoa học; \nđ) Tham gia các hội đồng tư vấn của nhà trường; tham gia bồi dưỡng giáo viên theo yêu cầu phát triển chuyên môn, nghiệp vụ của khoa hoặc chuyên ngành; \ne) Tham gia bồi dưỡng học viên giỏi. \n2. Tiêu chuẩn về trình độ đào tạo, bồi dưỡng \na) Có bằng tốt nghiệp đại học trở lên phù hợp với chuyên môn giảng dạy. Nhà giáo giảng dạy quân sự, võ thuật có bằng tốt nghiệp đại học trở lên, ngành, chuyên ngành được đào tạo đúng với chuyên môn giảng dạy hoặc có bằng tốt nghiệp đại học trở lên và một trong các văn bằng, chứng chỉ sau: bằng trung cấp chuyên ngành Huấn luyện viên quân sự, võ thuật trong Công an nhân dân; chứng chỉ bồi dưỡng quân sự, võ thuật; \nb) Bảo đảm các tiêu chuẩn quy định tại các điểm b và c khoản 2 Điều Thông tư này. \n3. Tiêu chuẩn về năng lực, chuyên môn nghiệp vụ \na) Đã đảm nhiệm chức danh Giáo viên từ đủ 36 tháng trở lên hoặc từ đủ 24 tháng nếu có bằng tiến sĩ, trong đó có ít nhất 12 tháng liên tục tính đến ngày hết thời hạn nộp hồ sơ đăng ký xét bổ nhiệm chức danh tại Hội đồng cấp trường; \nb) Nắm vững kiến thức, kỹ năng chuyên môn các môn học chính và kiến thức cơ bản các môn học có liên quan trọng chuyên ngành đào tạo đảm nhiệm; \nc) Hiểu rõ và áp dụng được mục tiêu, kế hoạch, nội dung, chương trình đào tạo, thực tiễn và xu thế phát triển của công tác đào tạo, nghiên cứu khoa học của chuyên ngành; \nd) Sử dụng thành thạo và an toàn các phương tiện, trang thiết bị dạy học; có phương pháp dạy học hiệu quả, phù hợp với nội dung môn học được phân công giảng dạy; giảng dạy đạt yêu cầu trở lên; \nđ) Có năng lực tổ chức, chỉ đạo, hướng dẫn cho học viên nghiên cứu khoa học; ứng dụng, triển khai những kết quả nghiên cứu khoa học vào công tác giáo dục, đào tạo và thực tiễn công tác của Công an nhân dân. ", dieu:"Điều 10", entity:"GiaoVienChinh"}}, {_id:108, properties:{answer:"1. Nhiệm vụ \nGiáo viên cao cấp thực hiện nhiệm vụ quy định tại Điều 8, khoản 1 Điều 10 Thông tư này và các nhiệm vụ sau: \na) Chủ trì tổ chức các hoạt động chuyên môn, nghiệp vụ của khoa hoặc chuyên ngành; \nb) Viết và tham gia báo cáo khoa học tại các hội nghị, hội thảo khoa học đóng góp vào sự phát triển của khoa hoặc chuyên ngành; \nc) Chủ trì tổ chức bồi dưỡng học viên giỏi. \n2. Tiêu chuẩn về trình độ đào tạo, bồi dưỡng \na) Có bằng thạc sĩ trở lên phù hợp với lĩnh vực, chuyên môn giảng dạy. Nhà giáo giảng dạy quân sự, võ thuật có bằng thạc sĩ trở lên phù hợp với lĩnh vực, chuyên môn giảng dạy hoặc thuộc nhóm ngành An ninh và trật tự xã hội, Tội phạm học và Phòng ngừa tội phạm và có chứng chỉ bồi dưỡng quân sự, võ thuật; giảng dạy võ thuật có chứng chỉ bồi dưỡng võ thuật nâng cao; \nb) Có chứng chỉ bồi dưỡng tiêu chuẩn chức danh Giáo viên cao cấp; \nc) Có chứng chỉ ngoại ngữ bậc 3 trở lên. Nhà giáo giảng dạy ngoại ngữ có trình độ ngoại ngữ thứ hai đạt bậc 3 trở lên; \nd) Có chứng chỉ tin học đạt Chuẩn kỹ năng sử dụng công nghệ thông tin nâng cao hoặc tương đương. \n3. Tiêu chuẩn về năng lực chuyên môn, nghiệp vụ \na) Đã đảm nhiệm chức danh Giáo viên chính từ đủ 60 tháng trở lên hoặc từ đủ 48 tháng nếu có bằng tiến sĩ, trong đó có ít nhất 24 tháng liên tục tính đến ngày hết thời hạn nộp hồ sơ đăng ký xét bổ nhiệm chức danh tại Hội đồng cấp trường; \nb) Có kiến thức và kỹ năng chuyên sâu về các môn học chính và kiến thức cơ bản các môn học có liên quan trong chuyên ngành đào tạo được đảm nhiệm; \nc) Nắm vững mục tiêu, kế hoạch, nội dung, chương trình đào tạo, thực tiễn và xu thế phát triển của công tác đào tạo, nghiên cứu khoa học của chuyên ngành; \nd) Có năng lực tổ chức, chỉ đạo tập thể giáo viên, học viên nghiên cứu khoa học; ứng dụng, triển khai những kết quả nghiên cứu khoa học vào công tác giáo dục và đào tạo và thực tiễn công tác của Công an nhân dân; \nđ) Giảng dạy được ít nhất 01 môn học hoặc nội dung bài giảng có khối lượng kiến thức ít nhất bằng 02 đơn vị học trình; \ne) Đã hoàn thành thời gian đi luân chuyển có thời hạn đến Công an đơn vị, địa phương theo quy định; \ng) Tổng điểm quy đổi đạt từ 7,0 điểm trở lên, trong đó có ít nhất 1,5 điểm hoạt động dạy giỏi và ít nhất 3,5 điểm công trình khoa học, hướng dẫn, huấn luyện; trong 03 năm học cuối tính đến thời điểm hết hạn nộp hồ sơ tại Hội đồng cấp trường có ít nhất 2,0 điểm công trình khoa học, hướng dẫn, huấn luyện. Nhà giáo giảng dạy võ thuật, giáo dục quốc phòng, giáo dục thể chất có tổng điểm quy đổi đạt từ 6,0 điểm trở lên, trong đó có ít nhất 1,5 điểm hoạt động dạy giỏi và 3,0 điểm công trình khoa học, hướng dẫn, huấn luyện; trong 03 năm học cuối tính đến thời điểm hết hạn nộp hồ sơ tại Hội đồng cấp trường có ít nhất 2,0 điểm công trình khoa học, hướng dẫn, huấn luyện. ", dieu:"Điều 11", entity:"GiaoVienCaoCap"}}, {_id:109, properties:{answer:"1. Thành phần Hội đồng cấp trường \na) Hiệu trưởng quyết định thành lập Hội đồng cấp trường, gồm: Chủ tịch là Hiệu trưởng hoặc Phó Hiệu trưởng (nếu được Hiệu trưởng ủy quyền); Phó Chủ tịch \nlà Phó Hiệu trưởng; Ủy viên Thư ký là lãnh đạo Phòng Tổ chức cán bộ (Phòng Chính trị/Phòng Chính trị và Quản lý học viên); các Ủy viên gồm đại diện lãnh đạo: Phòng Quản lý đào tạo và bồi dưỡng nâng cao (Phòng Quản lý đào tạo), Phòng Quản lý nghiên cứu khoa học, Phòng Khảo thí và đảm bảo chất lượng đào tạo và các đơn vị làm công tác giảng dạy (các khoa); \nb) Thành viên Hội đồng cấp trường phải có chức danh giảng dạy (Giáo sư, Phó Giáo sư, Giảng viên chính, Giáo viên cao cấp) hoặc có trình độ tiến sĩ (đối với cơ sở giáo dục đại học), trình độ thạc sĩ trở lên (đối với cơ sở giáo dục nghề nghiệp); \nc) Thường trực Hội đồng cấp trường gồm: Chủ tịch, Phó Chủ tịch và Ủy viên Thư ký; \nd) Hội đồng cấp trường có Tổ giúp việc, do Chủ tịch Hội đồng quyết định thành lập; thành phần gồm: lãnh đạo, cán bộ thuộc Phòng Tổ chức cán bộ (Phòng Chính trị/Phòng Chính trị và Quản lý học viên). \n2. Hội đồng cấp trường có trách nhiệm \na) Thẩm định hồ sơ của nhà giáo đăng ký xét bổ nhiệm chức danh giảng dạy (sau đây gọi chung là ứng viên) theo định kỳ hằng năm; \nb) Báo cáo Đảng ủy trường và công khai về kết quả thẩm định hồ sơ ứng viên của Hội đồng; \nc) Chịu trách nhiệm trước Hiệu trưởng, cơ quan có chức năng theo dõi, quản lý chức danh giảng dạy thuộc Bộ Công an và lãnh đạo Bộ Công an về những vấn đề có liên quan đến hoạt động của Hội đồng. \n3. Thường trực Hội đồng cấp trường có trách nhiệm \na) Thực hiện nhiệm vụ quy định tại khoản 2 Điều này; \nb) Giải quyết các công việc hành chính của Hội đồng; \nc) Báo cáo, đề xuất Hiệu trưởng quyết định việc miễn nhiệm, bãi nhiệm chức danh giảng dạy theo quy định tại Thông tư này; \nd) Quyết định triệu tập thành phần Hội đồng cấp trường rút gọn để họp, thẩm định hồ sơ đăng ký xét bổ nhiệm chức danh giảng dạy của các trường hợp quy định tại điểm b khoản 1 Điều 16 Thông tư này. \n4. Các trường hợp không được tham gia thành viên Hội đồng cấp trường: là ứng viên hoặc có người thân (vợ; chồng; con; anh, chị, em ruột; anh, chị, em ruột của vợ hoặc chồng) đăng ký xét chức danh giảng dạy. \n5. Hội đồng cấp trường được thành lập trước ngày 01/7 hằng năm, có nhiệm kỳ là 01 năm học và kết thúc sau khi hoàn thành nhiệm vụ trong năm học. ", dieu:"Điều 17", entity:"CapTruong"}}, {_id:110, properties:{answer:"1. Thành phần Hội đồng cấp Bộ \na) Lãnh đạo Bộ Công an phụ trách công tác giáo dục, đào tạo quyết định thành lập Hội đồng cấp Bộ, gồm: Chủ tịch là Cục trưởng hoặc Phó Cục trưởng Cục Đào tạo (nếu được Cục trưởng ủy quyền); Phó Chủ tịch là Phó Cục trưởng Cục Đào tạo phụ trách công tác quản lý dạy và học; Ủy viên Thư ký là lãnh đạo Phòng Quản lý công tác dạy và học, Cục Đào tạo; các Ủy viên gồm đại diện lãnh đạo: Cục Tổ chức cán bộ; Cục Pháp chế và cải cách hành chính, tư pháp; Cục Khoa học, Chiến lược và Lịch sử Công an, các cơ sở giáo dục đại học và cơ sở giáo dục nghề nghiệp; \nb) Thành viên Hội đồng cấp Bộ phải có chức danh giảng dạy (Giáo sư, Phó Giáo sư, Giảng viên chính, Giáo viên cao cấp) hoặc có trình độ tiến sĩ; \nc) Thường trực Hội đồng cấp Bộ gồm: Chủ tịch, Phó Chủ tịch và Ủy viên Thư ký; \nd) Hội đồng cấp Bộ có Tổ giúp việc, do Chủ tịch Hội đồng quyết định thành lập; thành phần gồm: lãnh đạo, cán bộ Phòng Quản lý công tác dạy và học thuộc Cục Đào tạo. \n2. Hội đồng cấp Bộ có trách nhiệm \na) Thẩm định hồ sơ đăng ký xét, công nhận đạt tiêu chuẩn chức danh Giảng viên chính, Giáo viên cao cấp định kỳ hằng năm; \nb) Chịu trách nhiệm trước lãnh đạo Bộ Công an về những vấn đề có liên quan đến hoạt động của Hội đồng. \n3. Thường trực Hội đồng cấp Bộ có trách nhiệm \na) Thực hiện các nhiệm vụ quy định tại khoản 2 Điều này; \nb) Giải quyết các công việc hành chính của Hội đồng; \nc) Quyết định triệu tập thành phần Hội đồng cấp Bộ rút gọn để họp, thẩm định hồ sơ và xem xét công nhận đạt tiêu chuẩn chức danh Giảng viên chính, Giáo viên cao cấp đối với các trường hợp quy định tại điểm b khoản 1 Điều 16 Thông tư này. \n4. Các trường hợp không được tham gia thành viên Hội đồng cấp Bộ nếu có người thân (vợ; chồng; con; anh, chị, em ruột; anh, chị, em ruột của vợ hoặc chồng) đăng ký xét, công nhận đạt tiêu chuẩn chức danh giảng dạy. \n5. Hội đồng cấp Bộ được thành lập trước ngày 15/8 hằng năm, có nhiệm kỳ là 01 năm học và kết thúc sau khi hoàn thành nhiệm vụ trong năm học. ", dieu:"Điều 18", entity:"CapBo"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Answer;
UNWIND [{_id:111, properties:{answer:"1. Nhà giáo tiến hành đăng ký xét chức danh giảng dạy; lãnh đạo đơn vị làm công tác giảng dạy tổ chức họp đơn vị để đánh giá, nhận xét, bỏ phiếu tín nhiệm cho từng ứng viên của đơn vị và báo cáo kết quả về Thường trực Hội đồng cấp trường (qua Phòng Tổ chức cán bộ/Phòng Chính trị/Phòng Chính trị và Quản lý học viên); ứng viên được đề nghị xét, bổ nhiệm phải đạt từ 2/3 số phiếu tín nhiệm của nhà giáo thuộc biên chế cơ hữu trong đơn vị trở lên. \n2. Trình tự thẩm định hồ sơ tại Hội đồng cấp trường \na) Thường trực Hội đồng cấp trường tổ chức kiểm tra hồ sơ, đối chiếu với tiêu chuẩn cụ thể của từng chức danh giảng dạy quy định tại Chương II Thông tư này để phân loại danh sách ứng viên; \nb) Tổ chức họp Hội đồng: Thường trực Hội đồng báo cáo kết quả kiểm tra hồ sơ ứng viên; thành viên Hội đồng trao đổi công khai, đánh giá và kết luận đối với từng ứng viên; thảo luận và thông qua danh sách những ứng viên đủ điều kiện để đưa vào danh sách lấy phiếu tín nhiệm; biểu quyết tín nhiệm bằng phiếu kín. Ứng viên được đề nghị bổ nhiệm chức danh giảng dạy phải đạt ít nhất 2/3 số phiếu tín nhiệm của tổng số thành viên Hội đồng, kết quả họp của Hội đồng phải được thông báo công khai trong thời gian ít nhất 07 ngày để lấy ý kiến tham gia của cán bộ, nhà giáo trong cơ sở giáo dục. \n3. Căn cứ kết quả xét duyệt của Hội đồng và ý kiến tham gia của cán bộ, nhà giáo, Đảng ủy cơ sở giáo dục ban hành quyết nghị. Ứng viên thuộc trường hợp xét bổ nhiệm của Hội đồng rút gọn, Ban Thường vụ Đảng ủy cơ sở giáo dục ban hành quyết nghị. \n4. Trên cơ sở quyết nghị của Đảng ủy hoặc Ban Thường vụ Đảng ủy cơ sở giáo dục, Hiệu trưởng ban hành quyết định bổ nhiệm chức danh Trợ giảng, Giảng viên, Giáo viên, Giáo viên chính. \n5. Cục trưởng Cục Đào tạo quyết định quy trình bổ nhiệm các chức danh quy định tại Điều này đối với các trường hợp đã được bổ nhiệm chức danh giảng dạy trước khi được tuyển chọn, điều động làm công tác giảng dạy. ", dieu:"Điều 19", entity:"TroGiang, GiangVien, GiaoVien, GiaoVienChinh"}}, {_id:112, properties:{answer:"1. Thực hiện theo quy định tại khoản 1 Điều 19 Thông tư này. \n2. Tổ chức xét, đề nghị công nhận đạt tiêu chuẩn chức danh giảng dạy tại Hội đồng cấp trường \na) Thực hiện theo quy định tại điểm a khoản 2 Điều 19 Thông tư này;  \nb) Chủ tịch Hội đồng phân công thành viên thẩm định hồ sơ của ứng viên; mỗi hồ sơ đăng ký xét bổ nhiệm chức danh giảng dạy phải được ít nhất 03 thành viên Hội đồng đánh giá bằng Phiếu thẩm định xét công nhận đạt tiêu chuẩn chức danh giảng dạy; \nc) Tổ chức họp Hội đồng: Thường trực Hội đồng báo cáo kết quả kiểm tra hồ sơ ứng viên; thành viên Hội đồng trao đổi công khai, đánh giá và kết luận đối với từng ứng viên; thảo luận, thông qua danh sách những ứng viên đủ tiêu chuẩn theo quy định và những ứng viên thuộc trường hợp quy định tại khoản 8 Điều này để đưa vào danh sách lấy phiếu tín nhiệm; lấy tín nhiệm bằng bỏ phiếu kín của Hội đồng; Ban Kiểm phiếu báo cáo kết quả kiểm phiếu. Ứng viên được tiếp tục đề nghị Hội đồng cấp Bộ xét, công nhận đạt tiêu chuẩn chức danh phải đạt ít nhất 2/3 số phiếu tín nhiệm của tổng số thành viên Hội đồng, kết quả họp của Hội đồng phải được thông báo công khai trong thời gian ít nhất 07 ngày để lấy ý kiến tham gia của cán bộ, nhà giáo trong cơ sở giáo dục; \nd) Căn cứ kết quả xét duyệt của Hội đồng và ý kiến tham gia của cán bộ, nhà giáo, Đảng ủy cơ sở giáo dục ra quyết nghị. \n3. Căn cứ quyết nghị của Đảng ủy cơ sở giáo dục, Hiệu trưởng có văn bản đè nghị xét công nhận đạt tiêu chuẩn chức danh và gửi kèm hồ sơ ứng viên đến Hội đồng cấp Bộ (qua Cục Đào tạo). \n4. Tổ chức xét công nhận đạt tiêu chuẩn chức danh giảng dạy tại Hội đồng cấp Bộ \na) Thường trực Hội đồng cấp Bộ tổ chức kiểm tra, rà soát, đối chiếu hồ sơ với các quy định tại Thông tư này; báo cáo Chủ tịch Hội đồng kết quả kiểm tra hồ sơ, danh sách phân loại ứng viên và thời gian tổ chức họp Hội đồng; \nb) Tổ chức họp Hội đồng phiên thứ nhất: Thường trực Hội đồng báo cáo kết quả kiểm tra hồ sơ của ứng viên và danh sách phân loại ứng viên; chuyển hồ sơ ứng viên để thành viên Hội đồng thẩm định theo phân công của Chủ tịch Hội đồng, mỗi ứng viên phải được ít nhất 03 thành viên Hội đồng đánh giá nhận xét bằng Phiếu thẩm định xét công nhận đạt tiêu chuẩn chức danh giảng dạy; \nc) Tổ chức họp Hội đồng phiên thứ hai: Thành viên Hội đồng trao đổi công khai về ý kiến thẩm định, đánh giá và kết luận đối với từng ứng viên; thảo luận, thông qua danh sách ứng viên đủ tiêu chuẩn theo quy định và ứng viên thuộc trường hợp quy định tại khoản 8 Điều này để đưa vào danh sách lấy phiếu tín nhiệm; Chủ tịch Hội đồng kết luận; thành viên Hội đồng bỏ phiếu tín nhiệm; Ban Kiểm phiếu báo cáo kết quả kiểm phiếu; Hội đồng quyết nghị việc đạt tiêu chuẩn chức danh giảng dạy đối với các ứng viên đạt ít nhất 2/3 số phiếu tín nhiệm của tổng số thành viên Hội đồng; \nd) Hội đồng báo cáo kết quả họp xét và xin ý kiến lãnh đạo Bộ Công an phụ trách công tác giáo dục, đào tạo xem xét đối với trường hợp quy định tại khoản 8 Điều này. \n5. Căn cứ ý kiến của lãnh đạo Bộ Công an phụ trách công tác giáo dục, đào tạo, Chủ tịch Hội đồng cấp Bộ ban hành quyết định công nhận đạt tiêu chuẩn chức danh giảng dạy. \n6. Căn cứ quyết định công nhận đạt tiêu chuẩn chức danh giảng dạy của Chủ tịch Hội đồng cấp Bộ, Hiệu trưởng cơ sở giáo dục ra quyết định bổ nhiệm chức danh giảng dạy. \n7. Cục trưởng Cục Đào tạo quyết định quy trình bổ nhiệm các chức danh quy định tại Điều này đối với các trường hợp đã được bổ nhiệm chức danh giảng dạy trước khi được tuyển chọn, điều động làm công tác giảng dạy. \n8. Ứng viên đến niên hạn xét bổ nhiệm chức danh Giảng viên chính, Giảng viên cao cấp đang trong thời gian hoàn thiện tiêu chuẩn theo quy định của Bộ trưởng Bộ Công an về khung tiêu chuẩn, tiêu chí bố trí cán bộ, giáo viên trong các trường Công an nhân dân nếu có tổng điểm quy đổi gấp hai lần trở lên so với mức điểm quy định của từng chức danh thì được báo cáo lãnh đạo Bộ Công an phụ trách công tác giáo dục, đào tạo xem xét trước khi quyết định.", dieu:"Điều 20", entity:"GiangVienChinh, GiaoVienCaoCap"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Answer;
